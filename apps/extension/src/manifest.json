{
  "manifest_version": 3,
  "name": "Harrier capture",
  "version": "0.1.0",
  "description": "Hands the open job page, or selected text, to Harrier's capture page.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Add this page to Harrier" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
