# Harrier environment. Copy to .env and fill in. .env never enters git (ADR-002).

# AI provider seam (harrier.llm): codex-cli | claude-cli | openai-api | anthropic-api | auto
AI_PROVIDER=codex-cli
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CODEX_CLI_PATH=
CLAUDE_CLI_PATH=
# Subscription token for the claude-cli provider, minted by `claude setup-token`
# on the host. This is the credential that reaches the container (spec 054);
# without it, and without the opt-in below, container AI runs fail loudly.
CLAUDE_CODE_OAUTH_TOKEN=
# Explicit opt-in to per-token API billing for the claude CLI. Leave empty to
# bill the subscription; set to 1 to hand the CLI ANTHROPIC_API_KEY instead.
CLAUDE_CLI_USE_API_KEY=

# Discovery
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=curious_coder/linkedin-jobs-scraper
APIFY_LINKEDIN_PROFILE_SEARCH_ACTOR=harvestapi/linkedin-profile-search
# The academic source's actor and the portal ids it accepts (spec 097). Both
# describe the kind of search, so they live here only, never in the code.
APIFY_ACADEMIC_ACTOR=
APIFY_ACADEMIC_PORTALS=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail watch (readonly scope)
GMAIL_ACCOUNT=
GMAIL_OAUTH_CLIENT_SECRET_FILE=secrets/google-oauth-client.json
GMAIL_OAUTH_TOKEN_FILE=secrets/google-oauth-token.json

# Outreach
HUNTER_API_KEY=

# Hosted API (spec 104). The local product leaves all four unset; unset or
# empty, HARRIER_AUTH keeps the local API of spec 035. Hosted, Fly sets them
# in the process environment. The API reads these four from its process
# environment only, never from .env, but docker-compose passes .env into the
# container's environment, so uncommenting HARRIER_AUTH in .env makes the
# local container's API refuse to start.
# HARRIER_AUTH=supabase
# HARRIER_SUPABASE_URL=https://<project-ref>.supabase.co
# HARRIER_ALLOWED_HOSTS=api.example.com
# HARRIER_CORS_ORIGINS=https://app.example.com
#
# Hosted only (spec 116): the key that encrypts each owner's credentials, a
# Fly secret on the API app, formatted <key id>:<base64 of 32 bytes>. The
# hosted API refuses to start without it; the local API ignores it, since
# local credentials are the variables above. The value below is a
# placeholder, not a key.
# HARRIER_CREDENTIALS_KEY=key-1:<base64 of 32 random bytes>
#
# Hosted only (spec 106): the run login role's URL, a Fly secret on the API
# app. A hosted run receives it as its HARRIER_DATABASE_URL and never under
# this name. The hosted API refuses to start without it, or when it names the
# API's own login role. The value below is a placeholder.
# HARRIER_RUN_DATABASE_URL=postgresql://harrier_run:<password>@<host>:5432/postgres
