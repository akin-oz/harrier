# Harrier environment. Copy to .env and fill in. .env never enters git (ADR-002).

# AI provider seam (harrier.llm): codex-cli | claude-cli | openai-api | anthropic-api | auto
AI_PROVIDER=codex-cli
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CODEX_CLI_PATH=
CLAUDE_CLI_PATH=

# Discovery
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=curious_coder/linkedin-jobs-scraper
APIFY_LINKEDIN_PROFILE_SEARCH_ACTOR=harvestapi/linkedin-profile-search

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail watch (readonly scope)
GMAIL_ACCOUNT=
GMAIL_OAUTH_CLIENT_SECRET_FILE=secrets/google-oauth-client.json
GMAIL_OAUTH_TOKEN_FILE=secrets/google-oauth-token.json

# Outreach
HUNTER_API_KEY=
