# Credentials: never in git (ADR-002)
.env
.env.*
!.env.example
secrets/

# All personal data lives in the local database and local files (ADR-008).
# Anchored to the repo root: unanchored patterns would also ignore nested dirs
# like .ai/state/ (which bit CI once) or a future apps/web/src/state.
/data/
/tracker/
/runtime/
/reports/
/state/
/incoming/
/logs/
/interview-prep/
/backups/

# Toolchains
node_modules/
.venv/
__pycache__/
*.pyc
dist/
.pytest_cache/
.ruff_cache/

# OS / editor noise
.DS_Store
.idea/

# Generated TypeScript build state
*.tsbuildinfo

# Real hold list: reason column is personal operational data (spec 007)
/config/companies-hold.csv

# User configuration: real watchlists and searches are personal data
# (ADR-009); committed .example files document the shapes.
/config/feeds.txt
/config/linkedin_search_urls.txt
/config/discovery.json

# Every config/*.example.* documents a real name the README tells you to
# create, and each real name holds personal data: the candidate profile, the
# resume truth source, the application narrative, the interview stories.
# Six of these were absent and staged cleanly under `git add -A`. The set is
# derived from the tree by test_classification_coverage.py, so a new example
# file with no entry here fails rather than leaking.
/config/candidate.json
/config/resume-content.json
/config/application-profile.json
/config/application-profile.md
/config/story-seeds.json
/config/outreach-defaults.json
