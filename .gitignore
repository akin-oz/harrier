# Credentials: never in git (ADR-002)
.env
.env.*
!.env.example
secrets/

# All personal data lives in the local database and local files (ADR-008).
# Anchored to the repo root: unanchored patterns would also ignore nested dirs
# like .ai/state/ (which bit CI once) or a future apps/web/src/state.
/data/
/tracker/
/runtime/
/reports/
/state/
/incoming/
/logs/
/interview-prep/
/backups/

# Toolchains
node_modules/
.venv/
__pycache__/
*.pyc
dist/
.pytest_cache/
.ruff_cache/

# OS / editor noise
.DS_Store
.idea/

# Generated TypeScript build state
*.tsbuildinfo

# Real hold list: reason column is personal operational data (spec 007)
/config/companies-hold.csv

# User configuration: real watchlists and searches are personal data
# (ADR-009); committed .example files document the shapes.
/config/feeds.txt
/config/linkedin_search_urls.txt
/config/discovery.json
