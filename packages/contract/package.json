{
  "name": "@harrier/contract",
  "version": "0.0.0",
  "private": true,
  "description": "Generated API contract: openapi.json and TypeScript types. Never hand-edited; regenerate with 'just contract'.",
  "types": "./src/schema.d.ts",
  "exports": {
    ".": {
      "types": "./src/schema.d.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts --default-non-nullable false"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.7.0"
  }
}
