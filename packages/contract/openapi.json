  "info": {
    "description": "Local-first job search automation API.",
    "title": "harrier",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/capture/add": {
      "get": {
        "operationId": "captureJobViaGet",
        "parameters": [
          {
            "in": "query",
            "name": "company",
            "required": false,
            "schema": {
              "default": "",
              "title": "Company",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "title",
            "required": false,
            "schema": {
              "default": "",
              "title": "Title",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "location",
            "required": false,
            "schema": {
              "default": "",
              "title": "Location",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "url",
            "required": false,
            "schema": {
              "default": "",
              "title": "Url",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "default": "manual",
              "title": "Source",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "description",
            "required": false,
            "schema": {
              "default": "",
              "title": "Description",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Capture Via Get"
      },
      "post": {
        "operationId": "captureJob",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureOut"
                }
              }
            },
            "description": "company and title are required"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureOut"
                }
              }
            },
            "description": "already in tracker"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Capture Via Post"
      }
    },
    "/health": {
